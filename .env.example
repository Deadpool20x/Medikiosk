# MediKiosk Environment Variables
# AI Providers — LLM chat chain runs in this order (Groq → Cerebras → NVIDIA NIM).
# OpenRouter is included as a class for external/test use but is excluded from
# the production LLM_CHAIN to avoid 401s on dead credentials.
# Each entry is optional. At least one must be set with a real key (not "your_...").
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_REFERER=https://medikiosk.local
OPENROUTER_TITLE=MediKiosk

# Backend Config
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend/data/medikiosk.db

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000
